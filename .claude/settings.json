{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-commit.sh",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo test:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo llvm-cov:*)",
      "Bash(cargo clippy:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(rustfmt --check:*)",
      "Bash(make test-quiet)",
      "Bash(make test)",
      "Bash(cargo fmt:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(git status:*)",
      "Bash(git show:*)"
    ],
    "deny": []
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000"
  }
}
