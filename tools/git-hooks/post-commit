#!/usr/bin/env bash
# Git hook: runs locally after every commit.
# If the commit changes something in the app (calculation engine, user interface, Cargo files), the
# desktop app is built in the background and installed in /Applications (tools/build-install.sh).
# The commit does not wait for it. Log: target/build-install.log
# Switch off for one commit: BUILD_INSTALL=0 git commit ...
# Installation: git config core.hooksPath tools/git-hooks

[ "${BUILD_INSTALL:-1}" = "0" ] && exit 0
[ "$(uname)" = "Darwin" ] || exit 0

root="$(git rev-parse --show-toplevel)"

# Build only if something changes that goes into the app (not tests and documentation)
if ! git diff-tree --root --no-commit-id --name-only -r HEAD \
     | grep -E '^(crates/(app|engine)/|Cargo\.(toml|lock)$)' \
     | grep -vqE '(^|/)tests/'; then
  exit 0
fi

mkdir -p "$root/target"
nohup "$root/tools/build-install.sh" >>"$root/target/build-install.log" 2>&1 </dev/null &
echo "post-commit: App wird im Hintergrund gebaut und installiert (Protokoll: target/build-install.log)."
exit 0
